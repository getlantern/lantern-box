#!/usr/bin/env bash
# Fake Alibaba Cloud CLI for prune-images.test.sh.
echo "$*" >>"$FAKE_DIR/calls.log"
if [ -n "${FAKE_ALI_FLAKY_ONCE:-}" ] && [ ! -f "$FAKE_DIR/flaked" ]; then
  touch "$FAKE_DIR/flaked"
  echo "ERROR: read: connection reset by peer" >&2
  exit 1
fi
region="" image=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --RegionId | --region) region="${args[$((i + 1))]}" ;;
    --ImageId) image="${args[$((i + 1))]}" ;;
  esac
done
case "$1 $2" in
  "ecs DescribeRegions") cat "$FAKE_DIR/ali-regions.json" ;;
  "ecs DescribeImages")
    if [ "$region" = "cn-nanjing" ]; then
      echo "ErrorCode: InvalidRegionId.NotFound Message: The specified RegionId does not exist in our records." >&2
      exit 1
    fi
    f="$FAKE_DIR/ali-images-$region.json"
    [ -f "$f" ] || f="$FAKE_DIR/ali-images-empty.json"
    if [ -n "$image" ]; then
      [ -n "${FAKE_ALI_DELETE_IMAGE_FAIL:-}" ] && { echo "ErrorCode: InternalError" >&2; exit 1; }
      touch "$FAKE_DIR/deleted-images"
      if grep -qx "$image" "$FAKE_DIR/deleted-images"; then
        echo '{"Images":{"Image":[]}}'
      else
        jq --arg id "$image" '.Images.Image |= map(select(.ImageId == $id))' "$f"
      fi
    else
      cat "$f"
    fi
    ;;
  "ecs DescribeInstances")
    if [ "$image" = "m-used" ]; then echo '{"TotalCount":1}'; else echo '{"TotalCount":0}'; fi
    ;;
  "ecs DeleteImage")
    [ -n "${FAKE_ALI_DELETE_IMAGE_FAIL:-}" ] && { echo "ErrorCode: InternalError" >&2; exit 1; }
    echo "$image" >>"$FAKE_DIR/deleted-images"
    echo '{}'
    ;;
  "ecs TagResources")
    [ -n "${FAKE_ALI_TAG_FAIL:-}" ] && { echo "ErrorCode: Forbidden.RAM" >&2; exit 1; }
    value="" snaps=()
    for ((i = 0; i < ${#args[@]}; i++)); do
      case "${args[$i]}" in
        --ResourceId.*) snaps+=("${args[$((i + 1))]}") ;;
        --Tag.1.Value) value="${args[$((i + 1))]}" ;;
      esac
    done
    for s in "${snaps[@]}"; do printf '%s\t%s\n' "$s" "$value" >>"$FAKE_DIR/tagged-$region"; done
    echo '{}'
    ;;
  "ecs DescribeSnapshots")
    # Snapshots tagged by an earlier run (fixture) plus any tagged in this one.
    # FAKE_ALI_BADTAG swaps in a fixture whose tag value is not an image ID.
    prior="$FAKE_DIR/ali-snapshots-$region.json"
    [ -n "${FAKE_ALI_BADTAG:-}" ] && [ -f "$FAKE_DIR/ali-snapshots-$region-badtag.json" ] && prior="$FAKE_DIR/ali-snapshots-$region-badtag.json"
    touch "$FAKE_DIR/tagged-$region"
    page=1 size=10
    for ((i = 0; i < ${#args[@]}; i++)); do
      case "${args[$i]}" in
        --PageNumber) page="${args[$((i + 1))]}" ;;
        --PageSize) size="${args[$((i + 1))]}" ;;
      esac
    done
    # FAKE_ALI_MANY_SNAPSHOTS=N adds N leftover snapshots of deleted images, to
    # need more than one page.
    jq -n --argjson page "$page" --argjson size "$size" --argjson many "${FAKE_ALI_MANY_SNAPSHOTS:-0}" \
      --slurpfile prior "$prior" --rawfile tagged "$FAKE_DIR/tagged-$region" '
      (($prior[0] // []) + [$tagged | split("\n")[] | select(. != "") | split("\t")
        | {SnapshotId: .[0], Tags: {Tag: [{TagKey: "lantern-box-prune-image", TagValue: .[1]}]}}]
        + [range($many) | {SnapshotId: "s-many-\(.)", Tags: {Tag: [{TagKey: "lantern-box-prune-image", TagValue: "m-gone"}]}}])
      | {Snapshots: {Snapshot: .[($page - 1) * $size : $page * $size]}}'
    ;;
  "ecs DeleteSnapshot")
    [ -n "${FAKE_ALI_SNAPSHOT_FAIL:-}" ] && { echo "ErrorCode: IncorrectSnapshotStatus" >&2; exit 1; }
    echo '{}'
    ;;
  *) echo "fake aliyun: unhandled: $*" >&2; exit 1 ;;
esac
