#!/usr/bin/env bash
# Fake OCI CLI for prune-images.test.sh.
echo "$*" >>"$FAKE_DIR/calls.log"
region=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [ "${args[$i]}" = "--region" ] && region="${args[$((i + 1))]}"
done
case "$*" in
  *"iam region-subscription list"*) cat "$FAKE_DIR/oci-regions.json" ;;
  *"compute image list"*)
    [ "$region" = "${FAKE_OCI_FAIL_REGION:-}" ] && { echo "ServiceError: 500" >&2; exit 1; }
    [ -f "$FAKE_DIR/oci-images-$region.json" ] || { echo "unexpected region $region" >&2; exit 1; }
    cat "$FAKE_DIR/oci-images-$region.json"
    ;;
  *"compute image delete"*) ;;
  *) echo "fake oci: unhandled: $*" >&2; exit 1 ;;
esac
