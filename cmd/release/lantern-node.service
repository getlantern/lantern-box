[Unit]
Description=Lantern node (lantern-box serve --register)
Documentation=https://github.com/getlantern/lantern-box#run-a-lantern-node
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
# A node needs no privileges: it listens on a high port and maps it on the
# router over UPnP, NAT-PMP or PCP. CAP_NET_BIND_SERVICE only matters if the
# operator picks a port below 1024 with --port.
# Needs systemd 235 or later. StateDirectory creates /var/lib/lantern-node,
# named in ExecStart rather than through $STATE_DIRECTORY, which only systemd
# 240 sets.
DynamicUser=yes
StateDirectory=lantern-node
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Extra serve flags, such as LANTERN_NODE_ARGS="--bandwidth-limit 10mbit --max-peers 5".
# The leading dash makes the file optional.
EnvironmentFile=-/etc/lantern-box/node.env
ExecStart=/usr/bin/lantern-box serve --register --state-dir /var/lib/lantern-node $LANTERN_NODE_ARGS
Restart=always
RestartSec=30s
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
